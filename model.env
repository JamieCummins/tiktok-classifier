# model.env — active model configuration
# Edit these lines to switch models; source before running classify.py or submitting jobs.
#
# Local:  source model.env && python classify.py ...
# HPC:    sourced automatically by hpc/run_classify.pbs and hpc/run_smoke_test.pbs

MODEL="Qwen/Qwen3.6-27B-FP8"
MODEL_LABEL="qwen36_27b_fp8"     # suffix for output columns: is_mental_health_qwen36_27b_fp8
QUANTIZATION=""                  # '' if pre-quantised; 'fp8' for on-the-fly quantisation
LANGUAGE_MODEL_ONLY=true         # true for multimodal architectures run text-only
DISABLE_THINKING=true            # true for Qwen3.x reasoning models

# Hosted backends read their own model keys, so switching --backend doesn't
# require editing the block above. API keys come from the environment
# (OPENROUTER_API_KEY, TYPESAFE_API_KEY), never this file.
OPENROUTER_MODEL="qwen/qwen3.6-27b"               # same model as the HPC run, provider-hosted
OPENROUTER_MODEL_LABEL="qwen36_27b_openrouter"    # separate label: provider precision may differ from FP8
JEV_MODEL="jev-1.14.0"                            # pinned; the jev-latest alias moves between versions
JEV_MODEL_LABEL="jev_1_14"

# ---------------------------------------------------------------------------
# Reference configs — copy the relevant block above to switch models
#
# Gemma 4 26B (run 1 — results already in metadata/data.parquet):
#   MODEL="google/gemma-4-26B-A4B-it"
#   MODEL_LABEL="gemma4_26b"
#   QUANTIZATION="fp8"
#   LANGUAGE_MODEL_ONLY=false
#   DISABLE_THINKING=false
# ---------------------------------------------------------------------------
